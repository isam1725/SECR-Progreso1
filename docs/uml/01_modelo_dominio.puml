@startuml 01_modelo_dominio
' SECR - Progreso 2 - Diagrama de clases del modelo de dominio SEGÚN EL CÓDIGO (paquete modelo)
' Verde = nuevo o modificado en el Progreso 2 · Gris punteado = planificado para la entrega final (no existe aún en el código)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 55
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #8C1D40
  ArrowColor #333333
  HeaderBackgroundColor #F6E7EC
}
skinparam class<<P2>> {
  BackgroundColor #EAF4EA
  BorderColor #2E7D32
}
skinparam class<<pendiente>> {
  BackgroundColor #F2F2F2
  BorderColor #9E9E9E
  FontColor #6E6E6E
  BorderStyle dashed
}
title SECR - Modelo de dominio implementado (Progreso 2)

package "modelo" {
  class Conductor {
    - cedula : String
    - nombreCompleto : String
    - fechaNacimiento : LocalDate
    - puntajeActual : double
    - estado : String
    + getEdad() : int
    + puedeRenovarLicencia() : boolean
    + cambiarEstado(nuevoEstado : String) : void
    + agregarInfraccion(i : Infraccion) : void
    + removerInfraccion(i : Infraccion) : boolean
    + agregarPrueba(p : Prueba) : void
    + calcularAniosSinInfracciones() : long
  }
  class Licencia {
    + {static} DURACION_ANIOS : int = 5
    - numero : String
    - categoria : String
    - fechaEmision : LocalDate
    - fechaVencimiento : LocalDate
    + estaVencida() : boolean
    + estaCercaDeCaducar(dias : int) : boolean
    + renovarDesde(fecha : LocalDate) : void
  }
  class RenovacionLicencia {
    - fechaRenovacion : LocalDate
    - numeroLicencia : String
    - vencimientoAnterior : LocalDate
    - vencimientoNuevo : LocalDate
  }
  class HistorialConduccion {
    - eventos : List<EventoConduccion>
    - puntajeInicial : double
    - puntosRecuperacion : double
    - bonificacionBuenComportamiento : double
    + agregarEvento(e : EventoConduccion) : void
    + removerEvento(e : EventoConduccion) : boolean
    + calcularPuntajeFinal() : double
  }
  abstract class EventoConduccion <<P2>> {
    # idEvento : String
    # fechaHora : LocalDate
    # ubicacion : String
    # gravedad : int
    # descripcion : String
    + calcularPuntosDeduccion() : int
    + clasificarGravedad() : String
  }
  class Infraccion
  class TipoEvento {
    - codigo : String
    - nombre : String
    - descripcion : String
    - puntosBase : int
    - estado : String
    + estaActivo() : boolean
  }
  enum NivelRiesgo <<P2>> {
    ROJO
    NARANJA
    AMARILLO
    VERDE
    - etiqueta : String
    - min : double
    - max : double
    + {static} clasificar(puntaje : double) : NivelRiesgo
  }
  class Curso {
    - codigo : String
    - nombre : String
    - puntosRecuperacion : int
    - duracionHoras : int
    - porcentajeMinimoAprobacion : double
    - estado : String
    + agregarPregunta(p : Pregunta) : void
  }
  class Pregunta {
    - id : String
    - texto : String
    - opciones : List<String>
    - respuestaCorrecta : int
    + esCorrecta(r : int) : boolean
  }
  class Prueba {
    - id : String
    - fecha : LocalDate
    - calificacion : double
    - motivo : String
  }
  class EvaluacionPrueba {
    - nota : double
    - aprobado : boolean
    - puntosRecuperados : int
  }
  class Alerta {
    - nivel : String
    - mensaje : String
    - fechaAlerta : LocalDate
  }
}

package "Entrega final (planificado, aún no implementado)" {
  class InscripcionCurso <<pendiente>>
  class Zona <<pendiente>>
  class TramoVial <<pendiente>>
}

Conductor "1" *-- "1" Licencia
Conductor "1" *-- "1" HistorialConduccion
Conductor "1" *-- "0..*" RenovacionLicencia : historialRenovaciones
Conductor "1" *-- "0..*" Infraccion : infracciones
HistorialConduccion "1" o-- "0..*" EventoConduccion : eventos
EventoConduccion <|-- Infraccion
EventoConduccion "0..*" --> "1" TipoEvento : tipo
Conductor "1" -- "0..*" Prueba : historialPruebas
Prueba "0..*" --> "1" Curso
Prueba "1" *-- "0..1" EvaluacionPrueba
Curso "1" *-- "0..*" Pregunta
Conductor ..> NivelRiesgo : se clasifica en
InscripcionCurso ..> Curso
TramoVial ..> Zona

legend right
  |= Color |= Significado |
  |<#FFFFFF>| Implementada (Progreso 1 / semestre anterior) |
  |<#EAF4EA>| Nueva o modificada en el Progreso 2 |
  |<#F2F2F2>| Planificada para la entrega final |
endlegend
@enduml
