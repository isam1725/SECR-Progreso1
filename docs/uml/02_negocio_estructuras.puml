@startuml 02_negocio_estructuras
' SECR - Capa de negocio y estructuras de datos (solo pilas, colas, árboles y grafos)
' Programación III - Progreso 1 - Grupo 4

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 70
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #8C1D40
  ArrowColor #333333
}
skinparam class<<estructura>> {
  BackgroundColor #E8F0FB
  BorderColor #1F4E8C
}
skinparam package {
  BorderColor #777777
}

title SECR - Módulos de negocio y estructuras de datos (Alternativa A seleccionada)

package "util" {
  class SistemaSECR {
    + getGestorConductores() : GestorConductores
    + getGestorEventos() : GestorEventos
    + getGestorRiesgo() : GestorRiesgo
    + getGestorCursos() : GestorCursos
    + getGestorReportes() : GestorReportes
  }
}

package "negocio" {
  class GestorConductores <<M1 Mateo Vasquez>> {
    - porLicencia : ArbolAVL<String, Conductor>
    - porNombre : ArbolAVL<String, Conductor>
    + registrarConductor(c : Conductor) : boolean
    + buscarPorLicencia(lic : String) : Conductor
    + buscarPorPrefijoNombre(p : String) : List<Conductor>
    + filtrar(categoria, estado) : List<Conductor>
    + renovarLicencia(lic : String) : RenovacionLicencia
  }

  class GestorEventos <<M2 Alex Palma>> {
    - indiceFechas : IndiceTemporalEventos
    - historialDeshacer : Pila<OperacionRegistro>
    + registrarEvento(...) : boolean
    + consultarPorRango(desde, hasta) : List<EventoConduccion>
    + ordenarPorGravedad(lista) : List<EventoConduccion>
    + deshacerUltimoRegistro() : void
    + infraccionMasComun() : String
  }

  class GestorRiesgo <<M3 Martín Jurado>> #EAF4EA {
    - ranking : RankingRiesgoAVL
    + recalcularPuntaje(c : Conductor) : double
    + actualizarPrioridad(lic : String, puntaje : double) : void
    + topRiesgo(k : int) : List<Conductor>
    + porSemaforo(nivel : NivelAlerta) : List<Conductor>
    + aplicarBonificacion(lic : String) : int
  }

  class GestorCursos <<M4 Amelio Macas>> {
    - cursos : ArbolAVL<String, Curso>
    - colaInscripciones : Cola<InscripcionCurso>
    + inscribir(c : Conductor, curso : Curso) : InscripcionCurso
    + asignarCupos(codigoCurso : String) : List<InscripcionCurso>
    + generarPruebaAleatoria(curso, n) : List<Pregunta>
    + calificarPrueba(...) : Prueba
    + reporteMejorCurso() : String
  }

  class GestorReportes <<M5 Israel Zurita>> {
    - mapaVial : Grafo
    - colaCaducidad : MonticuloBinario<Licencia>
    + alertasCaducidadPriorizadas(dias : int) : List<Alerta>
    + zonasCriticas(k : int) : List<Zona>
    + rutaOperativo(base, zona) : Ruta
    + zonasDeInfluencia(zona, saltos) : List<Zona>
    + generarReporteIndividual(c : Conductor) : String
  }
}

package "estructuras" {
  class "ArbolAVL<K, V>" as ArbolAVL <<estructura>> {
    - raiz : Nodo
    + insertar(k, v) : void
    + buscar(k) : V
    + eliminar(k) : boolean
    + rango(desde, hasta) : List<V>
    + primeros(k : int) : List<V>
  }
  class RankingRiesgoAVL <<estructura>> {
    - porLicencia : ArbolAVL<String, Conductor>
    - porRiesgo : ArbolAVL<ClaveRiesgo, Conductor>
    + actualizarPuntaje(lic, p) : void
    + topRiesgo(k : int) : List<Conductor>
    + enRangoPuntaje(min, max) : List<Conductor>
  }
  class IndiceTemporalEventos <<estructura>> {
    - porFecha : ArbolAVL<LocalDate, List<EventoConduccion>>
    + consultarRango(desde, hasta) : List<EventoConduccion>
  }
  class "MonticuloBinario<T>" as MonticuloBinario <<estructura>> {
    + insertar(x : T) : void
    + extraerMinimo() : T
    + menores(k, filtro) : List<T>
  }
  class "Cola<T>" as Cola <<estructura>> {
    + encolar(x : T) : void
    + desencolar() : T
  }
  class "Pila<T>" as Pila <<estructura>> {
    + apilar(x : T) : void
    + desapilar() : T
  }
  class Grafo <<estructura>> {
    - adyacencia : List<List<Arista>>
    + zonasCercanas(origen, saltos) : List<String>
    + rutaMasCorta(origen, destino) : Ruta
    + componentesConexas() : List<List<String>>
  }
}

SistemaSECR "1" *-- "1" GestorConductores
SistemaSECR "1" *-- "1" GestorEventos
SistemaSECR "1" *-- "1" GestorRiesgo
SistemaSECR "1" *-- "1" GestorCursos
SistemaSECR "1" *-- "1" GestorReportes

GestorConductores "1" *-- "2" ArbolAVL
GestorEventos "1" *-- "1" IndiceTemporalEventos
GestorEventos "1" *-- "1" Pila
GestorRiesgo "1" *-- "1" RankingRiesgoAVL
GestorCursos "1" *-- "1" Cola
GestorReportes "1" *-- "1" Grafo
GestorReportes "1" *-- "1" MonticuloBinario
RankingRiesgoAVL "1" *-- "2" ArbolAVL
IndiceTemporalEventos "1" *-- "1" ArbolAVL
Grafo ..> Cola : BFS
Grafo ..> MonticuloBinario : Dijkstra
Grafo ..> Pila : DFS

GestorEventos ..> GestorRiesgo : notifica deducción
GestorCursos ..> GestorRiesgo : notifica recuperación
GestorReportes ..> GestorRiesgo : consulta ranking

legend right
  |= Color |= Significado |
  |<#FFFFFF>| Gestor reutilizado (semestre anterior) |
  |<#EAF4EA>| Gestor nuevo (Progreso 2) |
  |<#E8F0FB>| Estructura propia: pila, cola, árbol o grafo |
  Estereotipo <<Mx Nombre>> = módulo y responsable
endlegend
@enduml
